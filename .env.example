# ---------- web UI ----------
# Protects the web UI. Required if HOST is anything other than 127.0.0.1.
APP_USERNAME=admin
APP_PASSWORD=
# 127.0.0.1 = this Mac only. 0.0.0.0 = reachable from your home network.
HOST=127.0.0.1
PORT=8000
# Seconds between background polls of Blink. Don't go much lower than 30.
REFRESH_INTERVAL=60

# ---------- AI clip descriptions ----------
# Anthropic API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
DETECT_ENGINE=claude          # claude | yolo (free, local, less smart)
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=low
AI_FRAMES=4                   # frames per clip sent to Claude
AI_FRAME_WIDTH=640            # px per frame; smaller = fewer tokens
DETECT_CAMERAS=               # comma-separated camera names; empty = all

# ---------- push notifications (ntfy app on your phone) ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                   # long random name; anyone who knows it can read your alerts
NTFY_TOKEN=                   # only for protected topics / self-hosted ntfy
PUBLIC_URL=                   # opened when you tap a notification (e.g. a Tailscale address)

# ---------- Blink Mini Pan-Tilt Mount ----------
PAN_STEP=15                   # degrees per D-pad press
TILT_STEP=10
