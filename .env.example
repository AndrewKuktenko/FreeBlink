# ---------- web server ----------
# Anyone signs in with their own Blink account; each account only sees its own cameras.
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other machines (use HTTPS in front!).
HOST=127.0.0.1
PORT=8000
# Seconds between background polls of Blink. Don't go much lower than 30.
REFRESH_INTERVAL=60
# Encrypts Blink tokens and API keys on disk. Leave empty to auto-generate data/secret.key.
SECRET_KEY=
# how long a browser stays signed in
SESSION_DAYS=30
# sign-in attempts per IP per 15 minutes
LOGIN_ATTEMPTS=8
# simultaneous live views per account
MAX_LIVE_PER_USER=2
# simultaneous live views on the whole server
MAX_LIVE_TOTAL=8
# stop watching accounts nobody opened for this long
INACTIVE_DAYS=60
# Optional: password-protect the whole site (private installs only)
APP_USERNAME=admin
APP_PASSWORD=

# ---------- AI clip descriptions ----------
# Each user adds their own Anthropic API key in Settings.
# claude | yolo (free, local, less smart)
DETECT_ENGINE=claude
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=low
# frames per clip sent to Claude
AI_FRAMES=4
# px per frame; smaller = fewer tokens
AI_FRAME_WIDTH=640
# comma-separated camera names; empty = all
DETECT_CAMERAS=

# ---------- push notifications (ntfy app on your phone) ----------
NTFY_SERVER=https://ntfy.sh
# only used to migrate a single-user install; users get random topics
NTFY_TOPIC=
# only for protected topics / self-hosted ntfy
NTFY_TOKEN=
# opened when you tap a notification (e.g. a Tailscale address)
PUBLIC_URL=

# ---------- Blink Mini Pan-Tilt Mount ----------
# degrees per D-pad press
PAN_STEP=15
TILT_STEP=10

# ---------- deployment (docker compose) ----------
# tunnel (Cloudflare Tunnel) or caddy (Let's Encrypt, needs ports 80/443)
COMPOSE_PROFILES=tunnel
# for tunnel: token from Cloudflare Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=
# for caddy: e.g. freeblink.duckdns.org
DOMAIN=
# FREEBLINK_IMAGE=ghcr.io/andrewkuktenko/freeblink:latest   # image servers pull and auto-update to (point it at your fork)
