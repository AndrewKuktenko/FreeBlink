# ---------- web server ----------
# Anyone signs in with their own Blink account; each account only sees its own cameras.
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other machines (use HTTPS in front!).
HOST=127.0.0.1
PORT=8000
# Seconds between background polls of Blink. Don't go much lower than 30.
REFRESH_INTERVAL=60
# Encrypts Blink tokens and API keys on disk. Leave empty to auto-generate data/secret.key.
SECRET_KEY=
SESSION_DAYS=30               # how long a browser stays signed in
LOGIN_ATTEMPTS=8              # sign-in attempts per IP per 15 minutes
MAX_LIVE_PER_USER=2           # simultaneous live views per account
MAX_LIVE_TOTAL=8              # simultaneous live views on the whole server
INACTIVE_DAYS=60              # stop watching accounts nobody opened for this long
# Optional: password-protect the whole site (private installs only)
APP_USERNAME=admin
APP_PASSWORD=

# ---------- AI clip descriptions ----------
# Each user adds their own Anthropic API key in Settings.
DETECT_ENGINE=claude          # claude | yolo (free, local, less smart)
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=low
AI_FRAMES=4                   # frames per clip sent to Claude
AI_FRAME_WIDTH=640            # px per frame; smaller = fewer tokens
DETECT_CAMERAS=               # comma-separated camera names; empty = all

# ---------- push notifications (ntfy app on your phone) ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                   # only used to migrate a single-user install; users get random topics
NTFY_TOKEN=                   # only for protected topics / self-hosted ntfy
PUBLIC_URL=                   # opened when you tap a notification (e.g. a Tailscale address)

# ---------- Blink Mini Pan-Tilt Mount ----------
PAN_STEP=15                   # degrees per D-pad press
TILT_STEP=10

# ---------- deployment (docker compose) ----------
DOMAIN=                       # e.g. freeblink.duckdns.org; Caddy gets HTTPS for it automatically
